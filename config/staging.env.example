# ==============================================================================
# Eventora Staging Environment Configuration (FR-ENV-STAGING)
# Independent database instance, sandbox payment gateway, test email adapter
# ==============================================================================

NODE_ENV=staging
PORT=4000
HOST=0.0.0.0

# Staging Database: Isolated Supabase / RDS PostgreSQL instance (never shared with prod)
DATABASE_URL=postgresql://eventora_staging_user:staging_secure_pass_2026@staging-db.eventora.internal:5432/eventora_staging?sslmode=require
DB_POOL_MAX=20

# Staging Redis / Queue: Dedicated staging cluster
REDIS_URL=rediss://default:staging_redis_pass_2026@staging-redis.eventora.internal:6379

# Authentication & Sessions
SESSION_SECRET=staging-eventora-session-secret-min32chars-2026!
CSRF_SECRET=staging-eventora-csrf-secret-min32chars-2026!
PRIVACY_PEPPER=staging-dpdp-privacy-pepper-2026

# Payment Gateway: Sandbox Simulator or YouPI-PG Sandbox instance
PAYMENT_ADAPTER=simulator
YOUPI_API_BASE_URL=https://sandbox-api.youpi-pg.internal
YOUPI_MERCHANT_ID=merch_staging_eventora_01
YOUPI_API_KEY=yp_test_key_staging_992819028301823901
YOUPI_WEBHOOK_SECRET=yp_whsec_test_staging_8830192830192830192830

# Transactional Email: Resend (Test Mode)
EMAIL_ADAPTER=resend
RESEND_API_KEY=re_test_staging_9938102938102938
FROM_EMAIL=Eventora Staging <notifications@staging.eventora.campus.edu>

# Frontend & CORS
CORS_ORIGIN=https://staging.eventora.campus.edu,https://staging-eventora.vercel.app
APP_BASE_URL=https://staging.eventora.campus.edu

# Observability
SENTRY_DSN=https://staging_key@o000000.ingest.sentry.io/0000001
SENTRY_RELEASE=staging-v1.0.0
LOG_LEVEL=debug
METRICS_SECRET=staging-metrics-scraper-secret-2026
