{
  "name": "eventora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:frontend": "pnpm --filter @eventora/frontend dev",
    "build:frontend": "pnpm --filter @eventora/frontend build",
    "preview:frontend": "pnpm --filter @eventora/frontend preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
