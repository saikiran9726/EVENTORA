# ========================================================
# Dockerfile.web - Static SPA Web Container with Nginx
# ========================================================

# Stage 1: Build Frontend Assets
FROM node:20-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@9.12.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/frontend/package.json ./packages/frontend/

RUN pnpm install --frozen-lockfile

COPY packages/shared/ ./packages/shared/
COPY packages/frontend/ ./packages/frontend/

RUN pnpm --filter @eventora/shared build && \
    pnpm --filter @eventora/frontend build

# Stage 2: Hardened Unprivileged Nginx Runtime (Non-Root & Read-Only Root FS)
FROM nginx:alpine-slim AS runner

# Create unprivileged eventora user (UID 10001) matching API/worker
RUN addgroup -g 10001 -S eventora && \
    adduser -u 10001 -S eventora -G eventora

# Remove default static index
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/packages/frontend/dist /usr/share/nginx/html

# Configure Nginx for unprivileged non-root execution (pid in /tmp)
RUN sed -i 's,/var/run/nginx.pid,/tmp/nginx.pid,g' /etc/nginx/nginx.conf && \
    sed -i '/user  nginx;/d' /etc/nginx/nginx.conf

# Setup writable directories for unprivileged user
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
    chown -R 10001:10001 /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html && \
    chmod -R 770 /var/cache/nginx /var/run /var/log/nginx

# Nginx configuration with Security Headers & SPA Fallback on port 8080
RUN cat <<'EOF' > /etc/nginx/conf.d/default.conf
server {
    listen 8080;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:4000 https://api.eventora.campus.edu; object-src 'none';" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Public passport route (no CDN edge caching)
    location ^~ /p/ {
        try_files $uri /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
    }
}
EOF

# Switch to unprivileged non-root user
USER 10001:10001

EXPOSE 8080

# Read-only root filesystem support: /tmp, cache and run must be mounted tmpfs
VOLUME ["/tmp", "/var/cache/nginx", "/var/run"]

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
