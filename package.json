{
  "name": "eventora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @eventora/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "license:check": "tsx scripts/check-licenses.ts",
    "contracts:check": "tsx scripts/verify-api-contracts.ts",
    "db:migrate": "pnpm --filter @eventora/backend db:migrate",
    "dev:frontend": "pnpm --filter @eventora/frontend dev",
    "build:frontend": "pnpm --filter @eventora/frontend build",
    "preview:frontend": "pnpm --filter @eventora/frontend preview",
    "build:backend": "pnpm --filter @eventora/shared build && pnpm --filter @eventora/backend build",
    "start:backend": "pnpm --filter @eventora/backend start"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "ical.js": "^2.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-jx2c-rxcm-jvmq",
        "GHSA-c96f-x56v-gq3h",
        "GHSA-667r-xxjv-c9mm",
        "GHSA-p68q-wchp-6fh7",
        "GHSA-hwr6-493r-vm6h",
        "GHSA-9q9j-q6p8-xq58",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
