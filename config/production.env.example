# ==============================================================================
# Eventora Production Environment Configuration (FR-ENV-PROD)
# Fully hardened Supabase Postgres, production Render API, live YouPI-PG Gateway
# ==============================================================================

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Production Database: Supabase PostgreSQL connection pooler (Session / Transaction mode)
DATABASE_URL=postgresql://postgres:[PROD_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_POOL_MAX=20

# Production Redis: Upstash or Render Managed Redis with TLS
REDIS_URL=rediss://default:[PROD_REDIS_PASSWORD]@eventora-prod.render.com:6379

# Authentication & Sessions
SESSION_SECRET=[PROD_CRYPTOGRAPHICALLY_SECURE_RANDOM_MIN32_CHARS]
CSRF_SECRET=[PROD_CRYPTOGRAPHICALLY_SECURE_RANDOM_MIN32_CHARS]
PRIVACY_PEPPER=[PROD_CRYPTOGRAPHICALLY_SECURE_SALT_MIN32_CHARS]

# Payment Gateway: Self-Hosted YouPI-PG Gateway (Live Merchant Mode)
PAYMENT_ADAPTER=youpi
YOUPI_API_BASE_URL=https://pay.campus.edu
YOUPI_MERCHANT_ID=merch_eventora_live_in
YOUPI_API_KEY=[PROD_YOUPI_MERCHANT_SECRET_KEY]
YOUPI_WEBHOOK_SECRET=[PROD_YOUPI_HMAC_SHA256_WEBHOOK_SECRET]

# Transactional Email: Resend Production Verified Campus Domain
EMAIL_ADAPTER=resend
RESEND_API_KEY=[PROD_RESEND_LIVE_API_KEY]
FROM_EMAIL=Eventora Campus <noreply@eventora.campus.edu>

# Frontend & CORS (No untrusted origin reflection)
CORS_ORIGIN=https://eventora.campus.edu,https://eventora.vercel.app
APP_BASE_URL=https://eventora.campus.edu

# Observability & Metrics
SENTRY_DSN=[PROD_SENTRY_BACKEND_DSN]
SENTRY_RELEASE=v1.0.0
LOG_LEVEL=info
METRICS_SECRET=[PROD_PROMETHEUS_BEARER_SCRAPER_TOKEN]
WORKER_HEARTBEAT_THRESHOLD_SECONDS=30
