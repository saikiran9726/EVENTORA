{
  "name": "@eventora/backend",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate-down.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@eventora/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "^9.9.2",
    "@sentry/node": "^11.10.0",
    "argon2": "^0.41.1",
    "bullmq": "^6.3.19",
    "drizzle-orm": "^0.33.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.9.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "qrcode": "^1.5.4",
    "resend": "^6.34.1",
    "svix": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.8",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
